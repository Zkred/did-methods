{
  "name": "@zkred/did-cid",
  "version": "0.1.0",
  "description": "did:cid resolution as a did-resolver plugin — thin client for an Archon gatekeeper",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zkred/did-methods.git",
    "directory": "packages/did-cid"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@zkred/did-core": "workspace:^"
  },
  "peerDependencies": {
    "did-resolver": "^4.1.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "did-resolver": {
      "optional": true
    }
  },
  "keywords": [
    "did",
    "did:cid",
    "did-resolver",
    "decentralized-identity",
    "archon",
    "ipfs"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  }
}
